# Copy to .env (backend reads backend/.env or the process environment). NEVER commit real values.

# --- Database ---------------------------------------------------------------
# Local PostgreSQL example. On Render/Neon/Supabase paste the provided connection string
# (postgres:// and postgresql:// are auto-converted to the psycopg driver).
DATABASE_URL=postgresql+psycopg://cmgrp:cmgrp@localhost:5432/cmgrp

# --- Auth -------------------------------------------------------------------
# Generate a long random value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=480

# --- CORS: comma-separated frontend origins ----------------------------------
CORS_ORIGINS=http://localhost:5173

# --- AI Grievance Assistant ---------------------------------------------------
# openai | anthropic | gemini | none   (none = labelled keyword fallback only)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=20

# --- Misc ----------------------------------------------------------------------
MAX_UPLOAD_MB=5
# Seeds fictional demo users/grievances on first start when the database is empty
SEED_ON_STARTUP=true

# --- Frontend (set in frontend/.env or on the hosting platform) ------------------
# VITE_API_URL=http://localhost:8001
